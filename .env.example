# Server
APP_NAME=ai-server
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]


# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/language_db

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure-password
POSTGRES_DB=language_db

# Default AI provider and model choices
AI_PROVIDER=openai # one of: openai, hf
OPENAI_API_BASE= # leave blank for api.openai.com or set your compatible base
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct